{
  "id": "resume-jd-match",
  "version": "0.1.0",
  "name": "简历 × JD 匹配诊断",
  "promise": "逐条比对岗位任职要求，指出你已具备的、缺的、以及简历里看不出来的",
  "scene": "job",
  "kind": "tool",
  "credits": 20,

  "artifacts": {
    "consumes": [
      {
        "type": "resume.parsed",
        "required": true,
        "producedBy": "deterministic:whatajob-resume-parser"
      },
      {
        "type": "jd.raw",
        "required": true,
        "producedBy": "user_input | jobs_db"
      }
    ],
    "produces": {
      "type": "match.report",
      "schemaVersion": 1
    }
  },

  "inputs": [
    {
      "key": "resume",
      "label": "你的简历",
      "type": "file",
      "accept": [".pdf", ".docx", ".txt"],
      "maxSizeMb": 20,
      "required": true,
      "askBack": "先上传一份简历吧，PDF 或 Word 都行。",
      "freeNote": "上传和解析不扣积分"
    },
    {
      "key": "jd",
      "label": "目标岗位",
      "type": "jd_ref_or_text",
      "required": true,
      "askBack": "你想诊断哪个岗位？可以从岗位库里挑一个，或者把 JD 直接粘进来。"
    },
    {
      "key": "focus",
      "label": "特别想知道什么",
      "type": "text",
      "required": false,
      "placeholder": "例：我这个专业背景够不够"
    }
  ],

  "pipeline": [
    {
      "step": "parse_resume",
      "engine": "deterministic",
      "impl": "whatajob-resume-parser",
      "credits": 0,
      "out": "resume.parsed"
    },
    {
      "step": "load_jd",
      "engine": "deterministic",
      "credits": 0,
      "out": "jd.raw"
    },
    {
      "step": "rule_score",
      "engine": "deterministic",
      "impl": "whatajob-match-v3",
      "credits": 0,
      "out": "match.ruleScore",
      "note": "只写入 meta，不进 prompt。与模型判定保持独立，两者分歧即人工复核队列"
    },
    {
      "step": "diagnose",
      "engine": "llm",
      "model": "qwen-plus",
      "prompt": "prompt.md",
      "credits": 20,
      "out": "match.report"
    }
  ],

  "output": {
    "type": "object",
    "required": ["overall", "requirements", "meta"],
    "additionalProperties": false,
    "properties": {
      "overall": {
        "type": "object",
        "required": ["score", "verdict", "oneLine"],
        "additionalProperties": false,
        "properties": {
          "score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "verdict": { "enum": ["strong", "fit", "stretch", "mismatch"] },
          "oneLine": {
            "type": "string",
            "maxLength": 80,
            "description": "一句话结论，必须点明最关键的那个 gap 或优势，不许说安慰话"
          }
        }
      },
      "requirements": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["requirement", "status"],
          "additionalProperties": false,
          "properties": {
            "requirement": {
              "type": "string",
              "description": "逐字取自 jd.raw 的一条任职要求，不得改写、合并或拆分"
            },
            "status": { "enum": ["matched", "gap", "unknown"] },
            "evidence": {
              "type": "object",
              "required": ["quote", "section"],
              "additionalProperties": false,
              "description": "status=matched 时必填",
              "properties": {
                "quote": {
                  "type": "string",
                  "description": "逐字取自 resume.parsed 正文的片段"
                },
                "section": {
                  "type": "string",
                  "description": "该片段所在章节名，如「实习经历」"
                }
              }
            },
            "severity": {
              "enum": ["blocking", "major", "minor"],
              "description": "status=gap 时必填。blocking=硬性门槛（学历/专业/年限/证书）；major=核心技能缺失；minor=加分项"
            },
            "suggestion": {
              "type": "string",
              "maxLength": 120,
              "description": "status=gap 时必填。必须可操作，且不得建议编造经历"
            },
            "whyUnclear": {
              "type": "string",
              "maxLength": 120,
              "description": "status=unknown 时必填。说明简历里缺哪个信息导致判断不了"
            }
          }
        }
      },
      "meta": {
        "type": "object",
        "required": ["jdRequirementCount"],
        "properties": {
          "jdRequirementCount": { "type": "integer" },
          "ruleScore": {
            "type": "object",
            "description": "whatajob-match-v3 的三维打分，仅用于与模型判定交叉校验，不参与生成"
          }
        }
      }
    }
  },

  "invariants": [
    "requirements 必须覆盖 jd.raw 中每一条任职要求，且每条只出现一次（count 必须等于 meta.jdRequirementCount）",
    "requirement 必须逐字取自 jd.raw",
    "status=matched 时 evidence.quote 必须逐字出现在 resume.parsed 正文中",
    "简历里判断不了的要求必须落 unknown，不得归入 matched 或 gap",
    "不得新增、推断或美化用户未写明的经历",
    "不得因简历出现某个领域词就判定具备该技能（例：写了「推荐/大模型」不等于具备算法工程能力）"
  ],

  "guarantees": [
    "不修改用户简历原文",
    "运行失败不扣积分",
    "上传与解析不扣积分"
  ]
}
