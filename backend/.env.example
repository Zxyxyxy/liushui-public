# 复制成 backend/.env 再填值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会上传。值不要加引号。

# ── 模型（三选一，按顺序检测：百炼 > DeepSeek > OpenAI 兼容接口） ──
# 阿里云百炼，默认用 qwen-plus
DASHSCOPE_API_KEY=
# DeepSeek 官方，默认用 deepseek-chat
DEEPSEEK_API_KEY=
# 任何 OpenAI 兼容接口（OpenAI 官方、中转网关、One-API 等）
OPENAI_API_KEY=
OPENAI_BASE_URL=
# 网关上实际可用的模型名；不确定就先跑 python3 probe_models.py
OPENAI_MODEL=

# ── 登录：一段固定的长随机串，不设的话每次重启所有人都要重新登录 ──
# 生成：python3 -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=

# ── 联网搜索（可选，不配就不启用） ──
# SEARCH_PROVIDER=bocha
# BOCHA_API_KEY=
# TAVILY_API_KEY=
# 只在本地测试时放行 Tavily 这类境外搜索源
# ALLOW_OVERSEAS_SEARCH=true

# ── 其他（可选） ──
# 上传的文件保留几天，默认 7
# UPLOAD_TTL_DAYS=7
# FLASK_DEBUG=1
